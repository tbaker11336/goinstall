# Server-side Postgres connection (Supabase: Supavisor transaction pooler,
# port 6543, as the postgres user). Never exposed to the browser.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/goinstall_dev

# Supabase project (Settings > API). The anon/publishable key is safe in the
# browser; the service role key is server-only and used for invites.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only: sign in as any seeded user without Supabase Auth.
# Ignored when NODE_ENV is production or on Vercel.
DEV_AUTH=true
DEV_AUTH_SECRET=change-me-to-a-long-random-string
